# ─── Banco de dados ───────────────────────────────────────────────
# Local (docker-compose.dev.yml) ou Postgres da sua VPS.
DATABASE_URL="postgresql://elephant:elephant@localhost:5432/elephant?schema=public"

# Usados pelo docker-compose.yml (produção) para subir o Postgres incluso.
POSTGRES_USER="elephant"
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_DB="elephant"

# ─── Autenticação (Auth.js) ───────────────────────────────────────
# Gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── App / Armazenamento ──────────────────────────────────────────
STORAGE_DIR="./storage"
APP_URL="http://localhost:3000"

# Domínio público (Caddy/HTTPS em produção). Ex.: artes.suaagencia.com.br
APP_DOMAIN="localhost"

# ─── Seed do usuário admin inicial ────────────────────────────────
SEED_ADMIN_EMAIL="admin@elephant.local"
SEED_ADMIN_PASSWORD="elephant123"
SEED_ADMIN_NAME="Admin elephant."
