# Caddy faz proxy reverso + HTTPS automático (Let's Encrypt).
# Defina APP_DOMAIN no .env (ex.: artes.suaagencia.com.br).
# Para teste local, APP_DOMAIN=localhost usa certificado interno.

{$APP_DOMAIN} {
	encode gzip
	# Limite de upload (logos/referências e PNG composto)
	request_body {
		max_size 25MB
	}
	reverse_proxy app:3000
}
